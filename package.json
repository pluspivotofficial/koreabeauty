    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "4.1.13",
    "tsx": "^4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
