# ---- 商品データソース（プロバイダ）の認証情報 ----
# 未設定のプロバイダは自動的に無効化され、同梱のシードデータのみで動作します。

# 楽天ウェブサービス（楽天市場商品検索API）
# https://webservice.rakuten.co.jp/ で無料のアプリIDを取得
RAKUTEN_APP_ID=
# 楽天アフィリエイトID（任意。設定するとアフィリエイトリンクになります）
RAKUTEN_AFFILIATE_ID=

# ---- 為替レート ----
# 未設定の場合は lib/currency.ts のフォールバックレートを使用します。
# 例: https://open.er-api.com/v6/latest/JPY （無料・キー不要）
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/JPY

# ---- 値下げ通知 ----
# 値下げを検知したときにPOSTするWebhook URL。
# Slack / Discord の Incoming Webhook URL をそのまま入れれば動きます。
# 未設定の場合、スナップショットは記録されますが通知は送られません。
PRICE_ALERT_WEBHOOK_URL=

# ---- サイト設定 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
